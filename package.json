{
  "name": "@matchplane/subplatform-auto",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "bun run check && bun run build.mjs",
    "check": "tsc --noEmit && bun run agent:check",
    "agent:check": "tsc -p agent/tsconfig.json --noEmit",
    "agent:test": "bun test agent/src/server.test.ts",
    "agent:compile": "bun build --compile agent/src/server.ts --outfile dist/matchplane-auto-agent",
    "agent:serve": "bun run agent/src/server.ts"
  },
  "dependencies": {
    "lucide-react": "latest",
    "motion": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}
